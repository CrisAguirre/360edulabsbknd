# Servidor
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas. Si se omite en desarrollo, se levanta MongoDB en memoria.
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/citoindagar360

# Seguridad. Cambiar en producción.
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-32-caracteres
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresco-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Semilla de demostración al iniciar en desarrollo
AUTO_SEED=true
